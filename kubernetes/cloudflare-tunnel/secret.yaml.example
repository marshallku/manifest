# Template only. Fill a COPY in /tmp, seal it with kubeseal, commit the sealed
# output as sealed-secret.yaml, and delete the plaintext. Never commit this
# filled in — `**/secret.yaml` is gitignored but this `.example` is not.
#
#   cp secret.yaml.example /tmp/cf.yaml   # edit /tmp/cf.yaml
#   kubeseal --controller-namespace kube-system --controller-name sealed-secrets \
#     --format yaml < /tmp/cf.yaml > sealed-secret.yaml
#   rm /tmp/cf.yaml
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-tunnel-credentials
  namespace: cloudflare-tunnel
type: Opaque
stringData:
  # Cloudflare account id (Overview page, right sidebar).
  account_id: "<cloudflare-account-id>"
  # Any name; the controller creates/adopts this tunnel.
  tunnel_name: "homelab-factory"
  # API token with: Account>Cloudflare Tunnel>Edit, Zone>DNS>Edit, Zone>Zone>Read.
  api_token: "<cloudflare-api-token>"
