apiVersion: v1
kind: Secret
metadata:
    name: grafana-credentials
    namespace: mgmt01
    labels:
        app: grafana
type: Opaque
stringData:
    admin-password: "changeme"
    influxdb-token: "changeme"
    # CH_GRAFANA_PASSWORD from analytics01:~/dev/manifest/docker-compose/analytics01/telemetry/.env
    clickhouse-password: "changeme"
