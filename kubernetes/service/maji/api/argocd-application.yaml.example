# Register maji-api with ArgoCD (run once, manually — Application CRs
# are not synced from this repo). `.example` so the Application that watches
# this directory does not try to apply it (it ignores *.yaml.example).
#
#   kubectl apply -f kubernetes/service/maji/api/argocd-application.yaml.example
#
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: maji-api
  namespace: argocd
spec:
  destination:
    namespace: maji
    server: https://kubernetes.default.svc
  project: miniapp
  source:
    path: kubernetes/service/maji/api
    repoURL: https://github.com/marshallku/manifest.git
    targetRevision: HEAD
  syncPolicy:
    automated:
      enabled: true
      prune: true
      selfHeal: true
