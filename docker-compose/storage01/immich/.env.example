# Copy to .env (gitignored) and fill in DB_PASSWORD before the first `up`.
#
# Derived from upstream's example.env:
#   https://github.com/immich-app/immich/releases/latest/download/example.env
# Only the paths and the password differ; the variable names are upstream's.

# Originals live on the ZFS mirror. Thumbnails and transcodes do NOT — they are
# redirected onto the NVMe in docker-compose.override.yml, because generating
# them is the small-random-write pattern that collapses these SMR drives.
UPLOAD_LOCATION=/mnt/photos/immich

# Postgres on the NVMe, never on the mirror. This is the single most important
# line in this file: a database on DM-SMR is the textbook way to make the pool
# unusable, and Immich writes to it constantly during import and ML indexing.
DB_DATA_LOCATION=/var/lib/homelab/immich/postgres

# Pin the major line. Upstream's compose defaults to `release`, which is a
# floating tag — `docker compose pull` would then carry the whole stack across a
# major version without warning, and Immich's release notes routinely include
# breaking database migrations.
IMMICH_VERSION=v3

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# openssl rand -base64 32
DB_PASSWORD=
