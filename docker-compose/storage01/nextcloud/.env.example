# Copy to .env (gitignored) and fill in before the first `up`.
#
# These are not new values. This stack adopted the database prd01 was already
# running, so MYSQL_DATABASE, MYSQL_USER and MYSQL_PASSWORD must match what the
# restored config.php names — it came across with the data and still points at
# the old database and user. Inventing fresh credentials here means the restored
# config.php points at a database that does not exist.
#
# Where to read them now that prd01 and its `docker-compose/nextcloud/.env` are
# gone: the live `.env` beside this file on storage01, or the running instance
# itself —
#
#   docker exec -u www-data nextcloud_app php occ config:system:get dbname
#   docker exec -u www-data nextcloud_app php occ config:system:get dbuser
#   docker exec -u www-data nextcloud_app php occ config:system:get dbpassword
#
# `dbpassword` included — config.php holds it in clear, so a running instance is
# the recovery path if `.env` is lost. Note what that means in the other
# direction: the `storage01-db` job dumps the database but carries no file from
# this directory, so a restore from backup alone does not hand you these values.

MYSQL_HOST=db
MYSQL_DATABASE=clouddb
MYSQL_USER=clouduser
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# WARNING: this variable only takes effect during a *fresh install*. The image's
# entrypoint writes trusted domains into config.php when it creates the
# instance, and this migration restores an existing config.php instead — so on
# this host the value below is inert. It is kept only to document intent.
#
# The restored config.php trusts `cloud.marshallku.dev` and nothing else (that
# is how it came off prd01), which means the LAN address is refused until it is
# added explicitly:
#
#   docker exec -u www-data nextcloud_app \
#     php occ config:system:set trusted_domains 1 --value=192.168.219.191
#
# That step is in README.md's migration procedure and is not optional — without
# it there is no way to reach the instance before the tunnel is repointed.
NEXTCLOUD_TRUSTED_DOMAINS=cloud.marshallku.dev 192.168.219.191 localhost

# Same as prd01. Large values matter here: the whole point of the move is that
# this host has 7 TB behind it instead of a single disk.
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=16G

# Unlike NEXTCLOUD_TRUSTED_DOMAINS above, these three *do* apply to a restored
# instance: the image ships config/reverse-proxy.config.php, which reads them
# through getenv() on every request rather than baking them in at install time.
# Verified against the running prd01 container.
#
# The tunnel terminates TLS and forwards over the LAN, so Nextcloud has to be
# told which hop to trust for X-Forwarded-*. Without this every request appears
# to come from the proxy, which breaks rate limiting and the brute-force app.
TRUSTED_PROXIES=192.168.219.0/24
OVERWRITEPROTOCOL=https
OVERWRITECLIURL=https://cloud.marshallku.dev

# Redis is deliberately NOT enabled here. config/redis.config.php also reads
# getenv() at runtime, so simply adding
#
#   REDIS_HOST=redis
#
# to this file switches memcache.locking and memcache.distributed over on the
# next restart — no config.php editing involved. Leave it out until the
# migration is verified, so that the move changes nothing but location.
