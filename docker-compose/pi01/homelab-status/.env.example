# Copy to .env (gitignored) and fill in before `docker compose up -d`.
#
# The same value has to be baked into the firmware: put it in STATUS_TOKEN in
# the esp32 repo's own .env, which is where the build injects it.
#
# Generate one with:
#   openssl rand -hex 24
#
# Leaving this empty makes the container refuse to start. That is deliberate:
# the payload names internal hosts, ports and services that Uptime Kuma itself
# keeps behind a login, so a forgotten token must fail loudly rather than serve
# all of that to the LAN. Minimum 16 characters.
#
# To deliberately run without auth (local smoke test only), set
# STATUS_ALLOW_ANONYMOUS=1 instead — it logs a warning on every start.
STATUS_TOKEN=
