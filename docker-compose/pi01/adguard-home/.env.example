# Copy to .env (gitignored) and fill in before running ./bootstrap.sh.
#
# Only URLs and credentials belong here. Sync behaviour is expressed as CLI
# flags in docker-compose.yaml so it stays reviewable in git, while secrets stay
# out of argv, which is world-readable through /proc/<pid>/cmdline. They are
# still visible to anyone with Docker access via `docker inspect`; this keeps
# them out of git and away from other local users, not out of Docker.
#
# adguardhome-sync documents the replica variables in indexed form
# (REPLICA1_URL, ...) for its multi-replica support. v0.9.2 binds the unindexed
# names used here just as well — verified with `run --printConfigOnly` — and the
# unindexed form keeps this file symmetric with ORIGIN_*. If both are ever set,
# the indexed names win.

# The existing AdGuard Home on prd01 — the source of truth for filter lists,
# rewrites, client settings and services.
ORIGIN_URL=http://192.168.219.100:3080
ORIGIN_USERNAME=
ORIGIN_PASSWORD=

# This replica. bootstrap.sh installs AdGuard with exactly these credentials, so
# the sync job and the instance it manages never drift apart — it reads them back
# through `docker compose config` rather than sourcing this file, so whatever
# compose makes of a value is what AdGuard is installed with. Quoting rules are
# therefore compose's, and a password containing `$` or quotes stays consistent
# between the two.
REPLICA_URL=http://192.168.219.127:3080
REPLICA_USERNAME=
REPLICA_PASSWORD=
