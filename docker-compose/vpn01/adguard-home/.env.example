# Copy to .env (gitignored) and fill in before running ./bootstrap.sh.
#
# Only URLs and credentials belong here. Sync behaviour is expressed as CLI flags
# in docker-compose.yaml so it stays reviewable in git, while secrets stay out of
# argv, which is world-readable through /proc/<pid>/cmdline.

# The AdGuard Home primary — source of truth for filter lists, rewrites, client
# settings and services. It moved from prd01 to app01 when prd01 retired
# (2026-09-09); port 8888 is AdGuard's configured http.address there, published
# directly by the primary's port mapping.
ORIGIN_URL=http://192.168.219.194:8888
ORIGIN_USERNAME=
ORIGIN_PASSWORD=

# This replica. bootstrap.sh installs AdGuard with exactly these credentials,
# reading them back through `docker compose config` rather than sourcing this
# file, so the sync job and the instance it manages cannot drift apart.
#
# 127.0.0.1, not the host address: this instance binds loopback only so that
# systemd-resolved keeps 127.0.0.53 for tailscaled. The sync container runs with
# host networking, so its loopback is the host's.
REPLICA_URL=http://127.0.0.1:3080
REPLICA_USERNAME=
REPLICA_PASSWORD=
